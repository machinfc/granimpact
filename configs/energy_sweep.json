{
  "_comment": [
    "Energy sweep: D(v) to test the D ~ E^(1/4) law (Uehara) and the",
    "logarithmic fit of the thesis. Driven by scripts/energy_sweep.py, which walks",
    "sweep.values and writes one case per speed reusing this config."
  ],
  "simulation": { "name": "energy_sweep", "dt": 2e-06, "t_settle": 0.25, "t_end": 0.10,
                  "output_every": 500, "seed": 20240521 },
  "domain": { "x": 0.45, "y": 0.45, "z": 0.25 },
  "particles": {
    "r_min": 0.0037, "r_max": 0.0042,
    "rho_grain": 2650.0, "packing_fraction": 0.524, "bed_height_fraction": 0.60,
    "young": 100000000.0, "poisson": 0.25, "restitution": 0.55, "friction": 0.40
  },
  "projectile": { "radius": 0.0354, "density": 1310.0, "phi": 0.50, "young": 5000000.0,
                  "poisson": 0.20, "yield_kPa": 17.15, "speed": 2.0, "angle_deg": 90.0,
                  "start_z": 0.20 },
  "contact": { "tangential": true, "rolling_friction": false, "tangential_stiffness_ratio": 1.0 },
  "settle": { "gravity_boost": 1.0, "ke_tolerance": 1e-09, "min_steps": 2000 },
  "gravity": { "gz": -9.81 },
  "boundaries": { "periodic_xy": false, "wall_restitution": 0.30, "fixed_bottom": true },
  "output": { "dir": "data/outputs", "vtk": false, "csv": true, "vtk_every": 2000 },
  "sweep": { "parameter": "projectile.speed", "values": [1.0, 1.5, 2.0, 2.5, 3.0, 4.0] }
}
