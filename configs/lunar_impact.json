{
  "_comment": [
    "Lunar analogue: g = 1.62 m/s^2 and a faster projectile (5 m/s), which makes",
    "settling and ejecta last much longer: that is why t_settle and t_end",
    "are larger and settling uses increased gravity so it does not drag on."
  ],
  "simulation": { "name": "lunar_impact", "dt": 2e-06, "t_settle": 0.25, "t_end": 0.30,
                  "output_every": 500, "seed": 20240520 },
  "domain": { "x": 0.45, "y": 0.45, "z": 0.25 },
  "particles": {
    "r_min": 0.0037, "r_max": 0.0042,
    "rho_grain": 1500.0, "packing_fraction": 0.524, "bed_height_fraction": 0.60,
    "young": 100000000.0, "poisson": 0.25, "restitution": 0.40, "friction": 0.50
  },
  "projectile": { "radius": 0.0354, "density": 1310.0, "phi": 0.50, "young": 5000000.0,
                  "poisson": 0.20, "yield_kPa": 17.15, "speed": 5.0, "angle_deg": 75.0,
                  "start_z": 0.20 },
  "contact": { "tangential": true, "rolling_friction": false, "tangential_stiffness_ratio": 1.0 },
  "settle": { "gravity_boost": 3.0, "ke_tolerance": 1e-09, "min_steps": 2000 },
  "gravity": { "gz": -1.62 },
  "boundaries": { "periodic_xy": false, "wall_restitution": 0.30, "fixed_bottom": true },
  "output": { "dir": "data/outputs", "vtk": true, "csv": true, "vtk_every": 2000 }
}
