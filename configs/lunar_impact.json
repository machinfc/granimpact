{
  "_comment": [
    "Lunar analogue (75-degree oblique impact): same bed and projectile properties",
    "as the terrestrial loose bed, varying only gravity (gz = -1.62 m/s^2)."
  ],
  "simulation": { "name": "lunar_impact", "dt": 2e-06, "t_settle": 0.25, "t_end": 0.30,
                  "output_every": 500, "seed": 20240520 },
  "domain": { "x": 0.45, "y": 0.45, "z": 0.25 },
  "particles": {
    "r_min": 0.0031, "r_max": 0.0042,
    "rho_grain": 2650.0, "packing_fraction": 0.524, "bed_height_fraction": 0.60,
    "young": 100000000.0, "poisson": 0.25, "restitution": 0.55, "friction": 0.40
  },
  "projectile": { "radius": 0.0354, "density": 1310.0, "phi": 0.50, "young": 5000000.0,
                  "poisson": 0.20, "yield_kPa": 17.15, "speed": 5.0, "angle_deg": 75.0,
                  "start_z": 0.20 },
  "contact": { "tangential": true, "rolling_friction": true, "rolling_friction_coeff": 0.15,
