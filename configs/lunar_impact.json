  "gravity": { "gz": -1.62 },
  "boundaries": { "periodic_xy": false, "wall_restitution": 0.30, "wall_friction": 0.40,
                  "wall_damping": 0.15, "fixed_bottom": true },
  "output": { "dir": "data/outputs/loose/lunar_impact", "vtk": true, "csv": true, "vtk_every": 2000 }
}
