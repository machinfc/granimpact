    given-names: "Frank"
    email: "frankcm.work@gmail.com"
    orcid: "https://orcid.org/0000-0002-6980-1813"
version: "0.3.0"
date-released: "2026-10-02"
license: MIT
repository-code: "https://github.com/machinfc/granimpact"
keywords:
  - discrete element method
  - granular media
  - impact cratering
  - scientific computing
  - high performance computing
  - C++
